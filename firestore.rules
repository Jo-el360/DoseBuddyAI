rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile and subcollections: Accessible ONLY by authenticated owner UID
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Caregiver access: Allow authenticated caregivers or patient owner to access dosage logs
    match /users/{userId}/dosage_logs/{logId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.role == 'caregiver'
      );
    }
  }
}
